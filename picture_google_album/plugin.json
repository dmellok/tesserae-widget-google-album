{
  "tesserae_compat": "1.x",
  "name": "Picture, Google Shared Album",
  "version": "0.1.1",
  "kind": "widget",
  "requires": [
    "network:photos.app.goo.gl",
    "network:photos.google.com",
    "network:lh3.googleusercontent.com"
  ],
  "description": "Rotates through photos in a Google Photos album shared by link, full bleed. In Google Photos: open the album, Share, 'Create link', then paste the link (https://photos.app.goo.gl/…). Reads the public share page directly, no Google account or API key needed.",
  "icon": "ph-google-photos-logo",
  "supports": { "sizes": ["sm", "md", "lg"] },
  "cell_options": [
    {
      "name": "album",
      "type": "string",
      "label": "Album share link (photos.app.goo.gl/…)",
      "default": ""
    },
    {
      "name": "orientation",
      "type": "select",
      "label": "Orientation filter",
      "default": "any",
      "choices": [
        { "value": "any",       "label": "Any" },
        { "value": "portrait",  "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "square",    "label": "Square" }
      ]
    },
    {
      "name": "mode",
      "type": "select",
      "label": "Selection",
      "default": "random",
      "choices": [
        { "value": "random",     "label": "Random each render" },
        { "value": "sequential", "label": "Sequential (rotates one per render)" }
      ]
    },
    {
      "name": "scale",
      "type": "select",
      "label": "Scale",
      "default": "fit",
      "choices": [
        { "value": "fit",     "label": "Fit (letterbox)" },
        { "value": "fill",    "label": "Fill (crop to cover)" },
        { "value": "stretch", "label": "Stretch (distort to fill)" },
        { "value": "blurred", "label": "Fit with blurred background" }
      ]
    },
    { "name": "show_caption", "type": "boolean", "label": "Show date + album-name overlay", "default": true },
    { "name": "show_sequence", "type": "boolean", "label": "Show sequence indicator (3 / 12)", "default": true }
  ],
  "render": { "dither": "floyd-steinberg", "needs_network": true, "full_bleed": true },
  "data_schema": {
    "fields": [
      { "name": "url", "type": "str", "label": "Photo URL" },
      { "name": "date", "type": "str", "label": "Date taken (ISO)" },
      { "name": "stream", "type": "str", "label": "Album name" },
      { "name": "width", "type": "num", "label": "Photo width (px)" },
      { "name": "height", "type": "num", "label": "Photo height (px)" },
      { "name": "index", "type": "num", "label": "Sequence index (1-based)" },
      { "name": "count", "type": "num", "label": "Photos after filter" }
    ],
    "sample": {
      "url": "https://lh3.googleusercontent.com/pw/EXAMPLE=w2048-h1536",
      "id": "AF1QipExample",
      "date": "2026-07-14T09:30:00Z",
      "stream": "Family Album",
      "width": 2048,
      "height": 1536,
      "index": 3,
      "count": 12
    }
  }
}
